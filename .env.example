# TMDB_API_KEY: The Movie Database API key (v3 auth key)
# Used server-side for real-time movie discover and streaming provider lookups.
TMDB_API_KEY="MY_TMDB_API_KEY"

# GEMINI_API_KEY: Optional Gemini API key for personalized movie reasoning.
# AI Studio automatically injects this at runtime from user secrets if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
